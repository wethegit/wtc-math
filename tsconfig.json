{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist"
  },
  "include": ["src", "test", "vite.config.ts", "vite.site.config.ts"],
  "exclude": ["dist", "dist-site", "node_modules", "demos"],
  "typedocOptions": {
    "out": "documentation",
    "entryPoints": "src/index.ts",
    "exclude": ["dist/*+.ts*"],
    "intentionallyNotExported": [
      "V4Q",
      "Mat3DeterminantFunction",
      "Mat4DeterminantFunction",
      "src/Mat3.ts:Mat4"
    ]
  }
}
