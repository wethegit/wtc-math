{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "name": "wtc-math",
  "entryPoints": [
    "../src/index.ts",
    "../src/Color.ts",
    "../src/Plane.ts",
    "../src/Ray.ts"
  ],
  "tsconfig": "../tsconfig.json",
  "out": "./api",
  "docsRoot": "./",
  "readme": "none",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "disableSources": false,
  "gitRevision": "master",
  "sourceLinkTemplate": "https://github.com/wethegit/wtc-math/blob/{gitRevision}/{path}#L{line}",
  "outputFileStrategy": "members",
  "entryFileName": "index",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "enumMembersFormat": "table",
  "propertyMembersFormat": "table",
  "categorizeByGroup": false,
  "navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  },
  "tableColumnSettings": {
    "hideSources": true,
    "leftAlignHeaders": true
  },
  "pageTitleTemplates": {
    "member": "{name}"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatValidationWarningsAsErrors": true,
  "defaultCategory": "Other",
  "intentionallyNotExported": [
    "V4Q",
    "Mat3DeterminantFunction",
    "Mat4DeterminantFunction",
    "src/Mat3.ts:Mat4"
  ],
  "excludeTags": [
    "@author",
    "@version",
    "@created"
  ]
}
