extends ./_layout

block title
  | wtc-math — Colour Math

block head
  style.
    .color-pick {
      width: 36px;
      height: 26px;
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 1px;
      background: var(--surface-2);
      cursor: pointer;
      flex-shrink: 0;
    }
    .swatch-inline {
      flex: 1;
      height: 26px;
      border-radius: var(--r);
      border: 1px solid var(--border);
    }
    .de-display {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .de-val {
      font-size: var(--fs-lg);
      font-weight: 600;
      color: var(--amber);
    }
    .de-label {
      font-size: var(--fs-sm);
      color: var(--text-dim);
      font-style: italic;
    }
    .temp-result {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
    }
    .temp-swatch {
      width: 32px;
      height: 18px;
      border-radius: var(--r);
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    .temp-label {
      font-size: var(--fs-sm);
      color: var(--text-dim);
    }
    .canvas-fill {
      flex: 1;
      overflow: hidden;
      background: var(--surface);
    }
    #cm-canvas { display: block; width: 100%; height: 100%; }

block header-desc
  p.header-desc
    a(href="./index.html") demos
    span.breadcrumb-sep ›
    span.breadcrumb-current Colour Math

block main
  main.demo-main
    aside.demo-controls

      div.ctrl-section
        h3 Base colour
        div.ctrl-row
          input.color-pick(type="color" id="baseColor" value="#3a86ff")
          div.swatch-inline#baseSwatch

      div.ctrl-section
        h3 Compare (ΔE)
        div.ctrl-row
          input.color-pick(type="color" id="compareColor" value="#ff006e")
          div.swatch-inline#compareSwatch
        div.de-display
          span.de-val#deVal —
          span.de-label#deLabel

      div.ctrl-section
        h3 Temperature
        div.ctrl-row
          span.ctrl-label K
          input.ctrl-slider(type="range" id="tempSlider" min="1000" max="12000" step="50" value="5500")
          input.ctrl-num(type="number" id="tempNum" min="1000" max="12000" step="50" value="5500")
        div.temp-result
          div.temp-swatch#tempSwatch
          span.temp-label#tempLabel

      div.ctrl-section.ctrl-section--fill
        h3 How it works
        p.info-text #[strong.txt-mid Harmonies] extract #[code.txt-amber [L, C, H]] with #[code.txt-green toOklch()] then rebuild at fixed hue offsets. Equal L and C means every swatch is perceptually balanced.
        p.info-text #[strong.txt-mid ΔE] is Euclidean distance in Oklab space — #[code.txt-green √(ΔL²+Δa²+Δb²)]. Below 0.02 is imperceptible; above 0.15 is clearly distinct.
        p.info-text #[strong.txt-mid Blackbody] maps Kelvin to CIE xy via Kang's polynomial, converts through XYZ→linear sRGB, normalises to the brightest channel, then gamma-encodes.

    div.canvas-fill#canvas-fill
      canvas#cm-canvas

block footer-links
  a.footer-link(href="./index.html") demos

block footer-right
  span.footer-right Color · harmonies · ΔE · blackbody

block scripts
  script(type="module" src="./colormath.ts")
