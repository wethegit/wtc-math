extends ./_layout

block title
  | wtc-math — Colour Harmonies

block head
  style.
    .harm-main {
      height: calc(100vh - var(--header-h) - var(--footer-h));
      display: flex;
      flex-direction: column;
      background: var(--surface);
    }
    .harm-canvas-area {
      flex: 1;
      overflow: hidden;
      position: relative;
      min-height: 0;
    }
    #harm-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .harm-toggles {
      flex-shrink: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      height: 54px;
      padding: 0 20px;
      border-top: 1px solid var(--border);
      background: var(--bg);
    }
    .harm-chip {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 5px 16px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-dim);
      font: 500 var(--fs-sm)/1 var(--font);
      letter-spacing: 0.04em;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
      -webkit-appearance: none;
      appearance: none;
    }
    .harm-chip.active {
      border-color: var(--accent);
      color: var(--text-mid);
    }
    .harm-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
      opacity: 0.25;
      transition: opacity 0.15s;
    }
    .harm-chip.active .harm-dot {
      opacity: 1;
    }

block header-desc
  p.header-desc
    a(href="./index.html") demos
    span.breadcrumb-sep ›
    span.breadcrumb-current Colour Harmonies

block main
  main.harm-main
    div.harm-canvas-area#harm-canvas-area
      canvas#harm-canvas
    div.harm-toggles
      button.harm-chip.active(type="button" data-key="triadic"    style="--accent: var(--amber)")
        span.harm-dot
        span Triadic
      button.harm-chip.active(type="button" data-key="analogous"  style="--accent: var(--green)")
        span.harm-dot
        span Analogous
      button.harm-chip.active(type="button" data-key="split-comp" style="--accent: var(--purple)")
        span.harm-dot
        span Split-comp
      button.harm-chip.active(type="button" data-key="tetradic"   style="--accent: var(--red)")
        span.harm-dot
        span Tetradic

block footer-links
  a.footer-link(href="./index.html") demos

block footer-right
  span.footer-right drag · hover to inspect

block scripts
  script(type="module" src="./harmonies.ts")
