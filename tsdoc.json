{
  "$schema": "https://developer.microsoft.com/json-schemas/tsdoc/v0/tsdoc.schema.json",
  "extends": ["typedoc/tsdoc.json"],
  "noStandardTags": false,
  "tagDefinitions": [
    { "tagName": "@chainable", "syntaxKind": "modifier" },
    { "tagName": "@constructor", "syntaxKind": "modifier" },
    { "tagName": "@static", "syntaxKind": "modifier" },
    { "tagName": "@version", "syntaxKind": "block" },
    { "tagName": "@created", "syntaxKind": "block" }
  ]
}
